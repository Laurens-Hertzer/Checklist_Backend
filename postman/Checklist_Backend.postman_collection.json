    {
      "name": "Checklist",
      "item": [
        {
          "name": "Add Checklist",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('testDate', new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Checklist is created with HTTP 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const checklist = pm.response.json();",
                  "    pm.expect(checklist.checklistId).to.exist;",
                  "    pm.collectionVariables.set('checklistId', checklist.checklistId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"task\": \"Phase 4 Postman test\",\n  \"completed\": false,\n  \"dueDate\": \"{{testDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/checklist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "checklist"
              ]
            },
            "description": "This is a POST request, submitting data to an API via the request body. This request submits JSON data, and the data is reflected in the response.\n\nA successful POST request typically returns a `200 OK` or `201 Created` response code."
          },
          "response": []
        },
        {
