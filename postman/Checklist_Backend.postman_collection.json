    {
      "name": "OtherApis",
      "item": [
        {
          "name": "Train",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response contains train connection details', function () {",
                  "    const train = pm.response.json();",
                  "    pm.expect(train.departureStation).to.be.a('string').and.not.empty;",
                  "    pm.expect(train.arrivalStation).to.be.a('string').and.not.empty;",
                  "    pm.expect(train).to.have.property('departureTime');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/train?from=Z%C3%BCrich&to=Winterthur",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "train"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "Zürich"
                },
                {
                  "key": "to",
                  "value": "Winterthur"
                }
              ]
            },
            "description": "Requests a connection from Zurich to Winterthur. Expected: 200 OK and a response containing departure/arrival stations and departure time. Requires the external timetable API."
